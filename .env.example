ALPACA_PROFILE=main
STRATEGY_VARIANT=barbell

# Per-profile credentials. Every profile is a separate Alpaca paper account,
# so variants can trade side by side without sharing a P&L.
ALPACA_MAIN_API_KEY=PK...
ALPACA_MAIN_SECRET_KEY=
ALPACA_MAIN_ACCOUNT_ID=

ALPACA_TEST2_API_KEY=PK...
ALPACA_TEST2_SECRET_KEY=
ALPACA_TEST2_ACCOUNT_ID=

ALPACA_TEST3_API_KEY=PK...
ALPACA_TEST3_SECRET_KEY=
ALPACA_TEST3_ACCOUNT_ID=

ALPACA_PAPER=true
ALPACA_OPTIONS_FEED=indicative
ALPACA_STOCK_FEED=iex

ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=

DRY_RUN=true
